+def _kill_port(port: int) -> None:
+    """Terminate any process listening on the given TCP port."""
+    import subprocess as sp
+    try:
+        result = sp.run(
+            ["netstat", "-ano"],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+        )
+        for line in result.stdout.splitlines():
+            parts = line.strip().split()
+            if len(parts) < 5:
+                continue
+            local_addr = parts[1]
+            pid = parts[4]
+            if f":{port}" in local_addr and pid.isdigit():
+                sp.run(["powershell", "-Command", f"Stop-Process -Id {pid} -Force"],
+                    capture_output=True, encoding="utf-8", errors="replace", timeout=3)
+                print(f"  Killed PID {pid} on port {port}.")
+    except Exception as exc:
+        print(f"  Port cleanup skipped ({exc}).")
+    import time as _time
+    _time.sleep(1.5)
+
